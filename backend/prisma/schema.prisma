generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SignInMethod {
  PASSWORD
  GOOGLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  fullName     String
  email        String       @unique
  username     String?      @unique
  signInMethod SignInMethod
  passwordHash String?
  googleSub    String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz

  sessions            Session[]
  events              Event[]
  receivedInvitations EventInvitation[]
  eventMemberships    EventMember[]
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  startTime   DateTime  @db.Timestamptz
  endTime     DateTime  @db.Timestamptz
  location    String?
  privateNote String?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  invitations EventInvitation[]
  members     EventMember[]

  @@index([ownerId, startTime])
  @@index([ownerId, deletedAt])
  @@index([deletedAt])
}

model EventInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  eventId        String           @db.Uuid
  /// Store the trimmed, lowercase address used for account lookup.
  inviteeEmail   String           @db.VarChar(254)
  inviteeUserId  String?          @db.Uuid
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  expiresAt      DateTime         @db.Timestamptz
  respondedAt    DateTime?        @db.Timestamptz
  /// Earliest time a repeat send can retry delivery. Null once the email has been sent.
  emailRetryAt   DateTime?        @db.Timestamptz

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee User? @relation(fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviteeEmail])
  @@index([inviteeUserId, createdAt])
  @@index([inviteeEmail, inviteeUserId])
}

model EventMember {
  eventId     String   @db.Uuid
  userId      String   @db.Uuid
  joinedAt    DateTime @default(now()) @db.Timestamptz
  privateNote String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, eventId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique @db.VarChar(64)
  expiresAt        DateTime @db.Timestamptz
  createdAt        DateTime @default(now()) @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
