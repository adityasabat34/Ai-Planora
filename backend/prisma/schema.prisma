generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SignInMethod {
  PASSWORD
  GOOGLE
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  fullName     String
  email        String       @unique
  username     String       @unique
  signInMethod SignInMethod
  passwordHash String?
  googleSub    String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz
}
