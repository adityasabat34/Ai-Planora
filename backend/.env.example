DATABASE_URL=postgresql://planora_app:replace_me@127.0.0.1:5433/planora
NODE_ENV=development
# Leave the default Next.js port 3000 available to the frontend.
PORT=3001
JWT_ACCESS_SECRET=replace_with_a_random_secret
GOOGLE_CLIENT_ID=

# Full frontend registration URL used in invitation emails. Set the deployed HTTPS page in production.
FRONTEND_INVITATION_URL=http://localhost:3000/register
# Development without SMTP saves emails to backend/var/mail.
SMTP_URL=
MAIL_FROM=Planora <invites@planora.test>
